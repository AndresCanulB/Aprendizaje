<%- include('partials/header') %>

<h1><%= title %></h1>

<% if(isActive) { %>
  <p>El usuario está activo</p>
<% } else { %>
  <p>El usuario no está activo</p>
<% } %>

<%= new Date().getFullYear() %>

<ul>
  <% users.forEach(user => { %>
    <li><%= user.name %> - <%= user.age %> - <%= user.email %></li>
  <% }) %>
</ul>

<%- include('partials/footer') %>
